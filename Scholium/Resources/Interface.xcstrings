    "In Edit or Source, pause after an unfinished sentence. AI suggests only the current sentence's suffix; press Tab to insert it. It never inserts automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "In Edit or Source, pause after an unfinished sentence. AI suggests only the current sentence's suffix; press Tab to insert it. It never inserts automatically." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在“编辑”或“源文本”中，输入未完成的句子后暂停片刻。AI 只建议当前句子的补全；按 Tab 插入，不会自动写入正文。" } }
      }
    },
