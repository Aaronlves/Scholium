    "Enable AI Continuation": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enable AI Continuation" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用 AI 续写" } }
      }
    },
