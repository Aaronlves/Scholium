          "stringUnit" : {
            "state" : "translated",
            "value" : "仅派生提醒；他们不判断证据或哲学质量。"
          }
        }
      }
    },
    "Derived structural reminders. They never determine evidence, quality, or permission to use a note." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Derived structural reminders. They never determine evidence, quality, or permission to use a note."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "派生结构提醒。他们从不确定证据、质量或使用笔记的许可。"
          }
        }
      }
    },
    "Describe why this Researcher Skill should change. Scholium validates the complete package structure; Apply also requires an attributed external evaluation bound to the exact proposed revision." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Describe why this Researcher Skill should change. Scholium validates the complete package structure; Apply also requires an attributed external evaluation bound to the exact proposed revision."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述为什么这个研究者技能应该改变。Scholium 验证完整的包结构；应用还需要与确切的拟议修订相关的外部评估。"
          }
        }
      }
    },
