          }
        }
      }
    },
    "The file operation completed, but portable Note metadata recovery is incomplete. Inspect Metadata before continuing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件操作已完成，但便携笔记元数据的恢复尚未完成。请检查元数据后再继续。"
          }
        }
      }
    },
    "The file operation completed, but stable note identity recovery is incomplete. Identity-dependent actions remain unavailable until recovery succeeds." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file operation completed, but stable note identity recovery is incomplete. Identity-dependent actions remain unavailable until recovery succeeds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件操作已完成，但稳定笔记身份的恢复尚未完成。恢复成功前，依赖身份的操作仍不可用。"
          }
        }
      }
    },
    "The file operation completed, but this window could not refresh its document view. Use Refresh instead of repeating the action." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file operation completed, but this window could not refresh its document view. Use Refresh instead of repeating the action."
          }
