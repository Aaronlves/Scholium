    "Declare the scope within which this note's claims apply. Limitations are optional and should describe material boundaries." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Declare the scope within which this note's claims apply. Limitations are optional and should describe material boundaries."
