          }
        }
      }
    },
    "Modern life trains us to expect visible results almost immediately. A message is delivered in seconds, but this speed quietly changes our sense of how long worthwhile work should take." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Modern life trains us to expect visible results almost immediately. A message is delivered in seconds, but this speed quietly changes our sense of how long worthwhile work should take."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现代生活训练我们几乎立即期待可见的结果。一条消息在几秒钟内就可以传递，但这种速度悄然改变了我们对有价值的工作应该花多长时间的感觉。"
          }
        }
      }
    },
