            "state" : "translated",
            "value" : "所选研究库已不可用。"
          }
        }
      }
    },
    "The settings were saved to the Triptych where the edit began. Reload Metadata Settings to show the currently active Triptych." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置已保存到开始编辑时的三联体。请重新载入元数据设置，以显示当前活跃的三联体。"
          }
        }
      }
    },
    "The stored metadata record is unavailable." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储的元数据记录不可用。"
          }
        }
      }
    },
    "The visited note '%@' is no longer available. Scholium kept the current document open." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The visited note '%@' is no longer available. Scholium kept the current document open."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
