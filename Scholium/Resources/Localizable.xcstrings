    "Derived reminders only; they do not judge evidence or philosophical quality." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Derived reminders only; they do not judge evidence or philosophical quality."
          }
        },
