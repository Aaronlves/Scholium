    },
    "This note is read-only in Scholium." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This note is read-only in Scholium."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此笔记在 Scholium 中是只读的。"
          }
        }
      }
    },
    "This note remains readable, but Comment, Research Record, restore, and file changes are unavailable until its records finish moving from %@ to %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This note remains readable, but Comment, Research Record, restore, and file changes are unavailable until its records finish moving from %1$@ to %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此笔记仍可阅读，但在其记录从 %1$@ 移至 %2$@ 完成之前，评论、研究记录、恢复和文件更改均不可用。"
          }
        }
      }
    },
    "This note uses an older property set. You can edit its existing properties now and add newer schema properties when useful." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This note uses an older property set. You can edit its existing properties now and add newer schema properties when useful."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此笔记使用较旧的属性集。您现在可以编辑其现有属性，并在有用时添加更新的架构属性。"
          }
        }
      }
    },
    "This page does not grant reusable authority. Until the standing-permission implementation is complete, every new write scope continues through the existing short-lived authorization boundary." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This page does not grant reusable authority. Until the standing-permission implementation is complete, every new write scope continues through the existing short-lived authorization boundary."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此页面不授予可重复使用的权限。在长期权限实施完成前，每个新的写入范围仍须经过现有的短期授权边界。"
          }
        }
      }
    },
    "This passage no longer has one reliable location." : {
      "localizations" : {
