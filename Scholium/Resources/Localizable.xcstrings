    },
    "This cannot be undone. Scholium removes the note, every active Discussion containing it, its Critique association, stable identity, and every Triptych checkpoint containing it. Finished Research Records retain a tombstone for the deleted note." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This cannot be undone. Scholium removes the note, every active Discussion containing it, its Critique association, stable identity, and every Triptych checkpoint containing it. Finished Research Records retain a tombstone for the deleted note."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。Scholium 会移除该笔记、所有包含它的活跃讨论、与之关联的评析、稳定身份，以及所有包含它的脉络检查点。已完成的研究记录会为被删除的笔记保留墓碑记录。"
          }
        }
      }
    },
    "This cannot be undone. Scholium removes the note, its Comments, Discussions, Critique association, stable identity, Research Record, and every Triptych checkpoint containing it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This cannot be undone. Scholium removes the note, its Comments, Discussions, Critique association, stable identity, Research Record, and every Triptych checkpoint containing it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。Scholium 会移除该笔记、评论、讨论、评析关联、稳定身份、研究记录，以及包含它的每个脉络恢复点。"
          }
        }
      }
    },
    "This comparison is disposable. It does not replace or modify either Skill." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This comparison is disposable. It does not replace or modify either Skill."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此比较是一次性的，不会替换或修改任何技能。"
          }
        }
      }
    },
    "This draft remains read-only and creates no current state." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This draft remains read-only and creates no current state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此草稿保持只读，不产生当前状态。"
          }
        }
      }
    },
    "This edits the Triptych Working Method directly. Saving creates a new package revision; the bundled reference remains unchanged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This edits the Triptych Working Method directly. Saving creates a new package revision; the bundled reference remains unchanged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会直接编辑脉络的工作方法。保存后将创建新的包修订，内置参考版本保持不变。"
          }
        }
      }
    },
    "This field was removed in Search v4. Choose the scope in the visible Search control." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This field was removed in Search v4. Choose the scope in the visible Search control."
