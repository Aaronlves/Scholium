        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定时忽略的项目会在 %@ 后返回；“保持不变”仅会在材料出现后续修订或在设置中恢复时返回。"
          }
        }
      }
    },
