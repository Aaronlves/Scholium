        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 使文档保持打开状态，因为活动编辑器在保存之前从 %@ 更改为 %@。"
          }
        }
      }
    },
    "Scholium kept the document open because the active editor changed from %arg to %arg before it could be saved." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
