    },
    "Scholium could not open %@. Choose the application again. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium could not open %@. Choose the application again. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 无法打开 %@。请再次选择该应用程序。%@"
          }
        }
      }
    },
    "Scholium could not record the Critique request and could not restore the Critique file automatically. %@ Recovery also failed: %@ Restore the Before Agent Work checkpoint before continuing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium could not record the Critique request and could not restore the Critique file automatically. %@ Recovery also failed: %@ Restore the Before Agent Work checkpoint before continuing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 无法记录评析请求，也无法自动恢复评析文件。%@ 恢复也失败：%@ 请先恢复“智能体工作前”恢复点，再继续。"
          }
        }
      }
    },
    "Scholium could not refresh the remembered application reference. Choose the application again if opening fails." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium could not refresh the remembered application reference. Choose the application again if opening fails."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 无法刷新记住的应用程序引用。如果打开失败，请重新选择该应用程序。"
          }
        }
      }
    },
    "Scholium could not remember the selected application. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium could not remember the selected application. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 无法记住所选的应用程序。%@"
          }
        }
      }
    },
    "Scholium could not restore the remembered agent application. Choose it again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium could not restore the remembered agent application. Choose it again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 无法恢复记住的智能体应用程序。再选择一次。"
          }
        }
      }
    },
    "Scholium does not claim that a multi-file operation is atomic across vaults or filesystems. These durable records identify what was restored and what still needs inspection." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium does not claim that a multi-file operation is atomic across vaults or filesystems. These durable records identify what was restored and what still needs inspection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 不保证跨研究库或文件系统的多文件操作具有原子性。这些持久记录会说明已恢复的内容以及仍需检查的内容。"
          }
        }
      }
    },
    "Scholium first creates Before Restore. Files created after this checkpoint move to Trash; files changed, moved, or deleted are restored from the selected checkpoint." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium first creates Before Restore. Files created after this checkpoint move to Trash; files changed, moved, or deleted are restored from the selected checkpoint."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 会先创建“恢复前”恢复点。在此恢复点之后创建的文件将移入废纸篓；更改、移动或删除的文件将从所选恢复点恢复。"
          }
        }
      }
    },
    "Scholium found no matching derived issues. Dismissed items return after %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium found no matching derived issues. Dismissed items return after %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 未发现匹配的派生问题。已忽略的项目在 %@ 后返回。"
          }
        }
      }
    },
    "Scholium found no matching derived issues. Dismissed items return after %arg." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium found no matching derived issues. Dismissed items return after %arg."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 未发现匹配的派生问题。已忽略的项目在 %arg 后返回。"
