          }
        }
      }
    },
    "Scholium kept the current editor open because the note continued changing while it was being saved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium kept the current editor open because the note continued changing while it was being saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 使当前编辑器保持打开状态，因为笔记在保存时不断变化。"
          }
        }
      }
    },
    "Scholium kept the document open because the active editor changed from %@ to %@ before it could be saved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium kept the document open because the active editor changed from %@ to %@ before it could be saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 使文档保持打开状态，因为活动编辑器在保存之前从 %@ 更改为 %@。"
          }
        }
      }
    },
    "Scholium kept the document open because the active editor changed from %arg to %arg before it could be saved." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium kept the document open because the active editor changed from %1$arg to %2$arg before it could be saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 使文档保持打开状态，因为活动编辑器在保存之前从 %1$arg 更改为 %2$arg。"
          }
        }
      }
    },
    "Scholium kept the exact editor buffer open because this document is no longer available through the active Triptych." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium kept the exact editor buffer open because this document is no longer available through the active Triptych."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 保留了原始编辑缓冲区，因为此文档已无法通过当前脉络访问。"
          }
        }
      }
    },
    "Scholium rechecks the current package revision and creates an undo snapshot before replacement when possible." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium rechecks the current package revision and creates an undo snapshot before replacement when possible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 会重新检查当前包的修订，并尽可能在替换前创建撤销快照。"
          }
        }
      }
    },
    "Scholium records and copies the request. Use the explicit handoff controls to open an agent app, then paste and submit it yourself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium records and copies the request. Use the explicit handoff controls to open an agent app, then paste and submit it yourself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 会记录并复制请求。请使用明确的交接控件打开智能体应用，然后自行粘贴并提交。"
          }
        }
      }
    },
    "Scholium records the request, copies it, and opens the chosen agent app. Paste and submit it yourself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium records the request, copies it, and opens the chosen agent app. Paste and submit it yourself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 会记录并复制请求，然后打开所选 Agent 应用。请自行粘贴并提交。"
          }
        }
      }
    },
    "Scholium retains the permission and fingerprint locally; the Research Record stores neither the path nor the source bytes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium retains the permission and fingerprint locally; the Research Record stores neither the path nor the source bytes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 只在本机保留权限和指纹；研究记录既不存储路径，也不存储来源字节。"
          }
        }
      }
    },
    "Scholium revalidates the note identity and revision before preparation. Write-capable Actions preserve the exact bytes they replace and remain subject to conflict and recovery checks." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium revalidates the note identity and revision before preparation. Write-capable Actions preserve the exact bytes they replace and remain subject to conflict and recovery checks."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 会在准备前重新验证笔记身份与版本。可写入的操作会保留其替换的精确字节，并继续接受冲突与恢复检查。"
          }
        }
      }
    },
    "Scholium revalidates the note identity and revision before preparation. Write-capable Actions receive a checkpoint and remain subject to conflict and recovery checks." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium revalidates the note identity and revision before preparation. Write-capable Actions receive a checkpoint and remain subject to conflict and recovery checks."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 会在准备前重新验证笔记身份和修订。可写操作会获得检查点，并继续接受冲突与恢复检查。"
          }
        }
      }
    },
    "Scholium stores the small portable .scholium folder beside Works. macOS therefore asks once for access to the folder containing Works; it is not added as a fourth vault." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium stores the small portable .scholium folder beside Works. macOS therefore asks once for access to the folder containing Works; it is not added as a fourth vault."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 将小型便携式 .scholium 文件夹存放在“写作”研究库旁。因此，macOS 会请求访问包含“写作”的文件夹；该文件夹不会成为第四个研究库。"
          }
        }
      }
    },
    "Scholium talks only to Zotero Desktop on localhost. No account, password, online API key, or Zotero data-folder permission is required. Scholium never modifies Zotero data." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium talks only to Zotero Desktop on localhost. No account, password, online API key, or Zotero data-folder permission is required. Scholium never modifies Zotero data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 仅与本地主机上的 Zotero 桌面对话。不需要帐户、密码、在线 API 密钥或 Zotero 数据文件夹权限。Scholium 永远不会修改 Zotero 数据。"
          }
        }
      }
    },
    "Scholium validates package structure and routing, not philosophical quality." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium validates package structure and routing, not philosophical quality."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 验证包结构和路由，而不是哲学质量。"
          }
        }
      }
    },
    "Scholium validates structure and bounded routing, not philosophical quality." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium validates structure and bounded routing, not philosophical quality."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 验证结构和受限路由，不判断哲学质量。"
          }
        }
      }
    },
    "Scholium will save and revalidate the current Notes, Skill, Profile, policy, lifecycle, identities, and revisions before recording this decision." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium will save and revalidate the current Notes, Skill, Profile, policy, lifecycle, identities, and revisions before recording this decision."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录此决定前，Scholium 会保存并重新验证当前笔记、Skill、Profile、政策、生命周期、身份和修订。"
          }
        }
      }
    },
    "Scholium will store Zotero item %@ in the Analysis so future matches are stable. Zotero itself remains unchanged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium will store Zotero item %@ in the Analysis so future matches are stable. Zotero itself remains unchanged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 会将 Zotero 项目 %@ 存储在分析中，因此未来的匹配是稳定的。Zotero 本身保持不变。"
          }
        }
      }
    },
