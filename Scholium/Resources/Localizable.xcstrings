    },
    "A Skill declares what it needs. This separate standing policy only decides when Scholium asks the researcher." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A Skill declares what it needs. This separate standing policy only decides when Scholium asks the researcher."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技能声明其所需能力。独立的长期政策只决定 Scholium 何时询问研究者。"
          }
        }
      }
    },
    "A Skill still used by a Working Method or Action Profile cannot be deleted. Remove its binding first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A Skill still used by a Working Method or Action Profile cannot be deleted. Remove its binding first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍由工作方法或操作配置使用的技能不能删除。请先移除其绑定。"
          }
        }
      }
    },
    "A manual checkpoint is a self-contained copy of the complete Triptych. It remains until you delete its folder in Finder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A manual checkpoint is a self-contained copy of the complete Triptych. It remains until you delete its folder in Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动恢复点是完整脉络的独立副本。它会一直保留，直到您在 Finder 中删除其文件夹。"
          }
        }
      }
    },
