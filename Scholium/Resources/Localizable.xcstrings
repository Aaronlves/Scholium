    "Saved searches remain in Scholium’s Application Support folder and never modify a vault." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved searches remain in Scholium’s Application Support folder and never modify a vault."
