        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此名称用于区分完整的研究领域。“写作”文件夹仍由研究者自行管理，不是应用管理的项目。"
          }
        }
      }
    },
    "The note changed before this edit could be applied. Read it again before deciding how to continue." : {
      "localizations" : {
