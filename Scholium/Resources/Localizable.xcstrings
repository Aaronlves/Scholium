          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。Scholium 会移除该笔记、评论、讨论、评析关联、稳定身份、研究记录，以及包含它的每个脉络恢复点。"
          }
        }
      }
    },
    "This clears the one current pending Method feedback comment. It does not change the Method or the Researcher Evaluation." : {
