          }
        }
      }
    },
    "Scholium kept the current editor open because an editor update did not reach the autosave mirror. The complete editor buffer was recovered; retry the save." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium kept the current editor open because an editor update did not reach the autosave mirror. The complete editor buffer was recovered; retry the save."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scholium 使当前编辑器保持打开状态，因为编辑器更新未到达自动保存镜像。完整的编辑器缓冲区已恢复；重试保存。"
          }
        }
      }
    },
    "Scholium kept the current editor open because it could not retrieve the complete Markdown buffer." : {
      "localizations" : {
