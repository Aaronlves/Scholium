    },
    "Scholium kept the document open because the active editor changed from %@ to %@ before it could be saved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scholium kept the document open because the active editor changed from %@ to %@ before it could be saved."
          }
