          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "润色附带选段，保留原有论点、术语、限定条件、引用及 Markdown 结构。仅返回建议替换的 Markdown 正文，不加代码围栏或开场说明。不要修改笔记。"
          }
        }
      }
