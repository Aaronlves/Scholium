          }
        }
      }
    },
    "This is a complete, backend-validated Researcher Skill snapshot. Restore rechecks the current package and creates a new undo snapshot before replacement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is a complete, backend-validated Researcher Skill snapshot. Restore rechecks the current package and creates a new undo snapshot before replacement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一个完整的、经过后端验证的研究者技能快照。恢复会重新检查当前包并在替换之前创建新的撤消快照。"
          }
        }
      }
    },
    "This is a new note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is a new note"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
