    "This will remove %lld older settled versions across %lld Notes. Current Markdown and temporary Action recovery are not removed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will remove %1$lld older settled versions across %2$lld Notes. Current Markdown and temporary Action recovery are not removed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从 %2$lld 篇笔记中移除 %1$lld 个较早的暂定版本。当前 Markdown 与操作的临时恢复数据不会被移除。"
          }
        }
      }
    },
    "Timed dismissal hides only the derived reminder for the selected duration. Leave Unchanged hides only the exact Material revision pair until the Material changes again or you restore dismissed items here. Neither action changes a note, its Connections, or Research Record facts." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timed dismissal hides only the derived reminder for the selected duration. Leave Unchanged hides only the exact Material revision pair until the Material changes again or you restore dismissed items here. Neither action changes a note, its Connections, or Research Record facts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定时忽略只会在所选时段内隐藏派生提醒。“保持不变”仅隐藏准确的材料修订对，直到材料再次变化或你在此恢复已忽略项目。两种操作都不会更改笔记、连接或研究记录事实。"
          }
        }
      }
    },
    "Timed dismissals return after %@; Leave Unchanged returns only for a later Material revision or when restored in Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timed dismissals return after %@; Leave Unchanged returns only for a later Material revision or when restored in Settings."
