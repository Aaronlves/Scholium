    "Footnote and endnote citation styles are unavailable. Your text was preserved.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Footnote and endnote citation styles are unavailable. Your text was preserved."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "脚注和尾注引用样式不可用。您的文本已保留。"}}}},
