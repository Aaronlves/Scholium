{
  "compilerOptions": {
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "target": "ES2023",
    "types": []
  },
  "include": ["*.ts"],
  "exclude": ["tests"]
}
