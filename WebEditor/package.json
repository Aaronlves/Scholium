{
  "name": "scholium-editor",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "esbuild editor.ts --bundle --format=iife --platform=browser --target=safari17 --outfile=../Scholium/Resources/Editor/editor.bundle.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@lezer/common": "1.5.2",
    "@lezer/markdown": "1.7.1",
    "katex": "0.18.1",
    "mermaid": "11.16.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "esbuild": "0.28.1",
    "linkedom": "0.18.13",
    "type-fest": "5.8.0",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
