<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- XCTest must deliver per-journey launch arguments and the isolated
         fixture/home environment. A sandboxed macOS runner launches through
         NSWorkspace, which drops those inputs on the selected toolchain. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
